+uint64
+sys_setpriority(void)
+{
+  int pid, priority;
+  argint(0, &pid);
+  argint(1, &priority);
+  return setpriority(pid, priority);
+}
+
+uint64
+sys_getpinfo(void)
+{
+  uint64 st_addr;
+  argaddr(0, &st_addr);
+  if(st_addr == 0)
+    return -1;
+
+  struct pstat st;
+  if(getpinfo(&st) < 0)
+    return -1;
+
+  if(copyout(myproc()->pagetable, st_addr, (char *)&st, sizeof(st)) < 0)
+    return -1;
+
+  return 0;
+}

